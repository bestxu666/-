# Next.js 服务端数据库访问（不使用 NEXT_PUBLIC_ 前缀）
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# 仅供 db:migrate / db:seed 使用的 PostgreSQL 管理连接；使用数据库提供方要求的 SSL 配置。
DATABASE_URL=

# Python 决策服务。浏览器仍通过 Next.js 的 /api/decision/* 同源访问。
DECISION_BACKEND_URL=http://127.0.0.1:8000
DECISION_BACKEND_TIMEOUT_MS=30000
DECISION_BACKEND_API_KEY=
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1
BACKEND_PYTHON=python3
DECISION_ALGORITHM_FACTORY=app.algorithms.configurable:create_algorithm
# 可选：替换整个 ASGI 应用，或指定独立的工法/模板目录 JSON 文件。
# BACKEND_ASGI_APP=app.main:app
# BACKEND_CATALOG_PATH=/path/to/decision.json

# 默认 backend：所有计算使用 Python。仅在明确需要离线演示时设为 mock。
NEXT_PUBLIC_DECISION_CHANNEL=backend

# D1 默认读取数据库；只有显式 local-test 才使用隔离 PGlite。
DECISION_DATA_SOURCE=database
# pnpm dev:d1 自动设置 local-test 并初始化本地合成资料。
DECISION_LOCAL_TEST_PATH=.local/decision-test
# pnpm dev:all / dev:d1 为两个进程自动生成共享内部密钥。
# 分别启动或跨容器部署时，Next.js 和 Python 都必须配置同一密钥。
DECISION_CATALOG_API_KEY=
DECISION_CATALOG_URL=http://127.0.0.1:5000/api/internal/decision-catalog

# D2 响应提供器。正式模式默认未接入；测试提供器仅由 dev:d2 显式启用。
DECISION_RESPONSE_FACTORY=app.algorithms.response.base:create_unavailable
DECISION_ALLOW_TEST_RESPONSES=false
DECISION_RESPONSE_TIMEOUT_SECONDS=5
# D2 独立目录；不复用 .env 中 D1 的默认路径。终端显式 DECISION_LOCAL_TEST_PATH 优先。
DECISION_D2_LOCAL_TEST_PATH=.local/decision-d2-test
